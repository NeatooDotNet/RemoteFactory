<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- Only target net9.0+ where [FeatureSwitchDefinition] is supported -->
		<!-- Clear TargetFrameworks from Directory.Build.props; use single TFM for trimming test -->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>RemoteFactory.TrimmingTests</RootNamespace>

		<!-- Trimming configuration -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<!-- Suppress trimming warnings for this prototype -->
		<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<!-- Source generator output for inspection -->
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>

		<!-- Suppress code analysis noise. CA1031: the harness deliberately catches all
		     exceptions — any exception means the check failed; report it and keep going.
		     CA1849: IClientTallyPort exposes both a sync and an async form on purpose, so
		     each bare [Execute] can match its [Remote] sibling's async-ness. The static
		     pair is synchronous on both halves by design, so calling the sync form there
		     is the control, not a missed await.
		     CA1062: the "externally visible" methods here are [Execute] targets and a
		     relay hook, all invoked by generated code or the harness itself with values
		     it just constructed. Null-guarding them would add branches to the very method
		     bodies the trimming gate greps for, for arguments that cannot be null. -->
		<NoWarn>CA1861, CA1865, CA1510, IDE0021, IDE0022, IDE0023, IDE1006, CA1050, CA1822, CA1031, CA1849, CA1062</NoWarn>
	</PropertyGroup>

	<!-- Feature switch: set IsServerRuntime to false for client/trimming scenario -->
	<ItemGroup>
		<RuntimeHostConfigurationOption Include="Neatoo.RemoteFactory.IsServerRuntime" Value="false" Trim="true" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\RemoteFactory\RemoteFactory.csproj" />
		<ProjectReference Include="..\..\Generator\Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- Exclude generated files from compilation (they're included automatically) -->
	<ItemGroup>
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
	  <PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

</Project>
